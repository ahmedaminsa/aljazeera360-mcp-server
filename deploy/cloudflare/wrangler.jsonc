// Cloudflare Containers deployment for the Al Jazeera 360 MCP server.
// Requires: Workers Paid plan + Docker running locally for `wrangler deploy`.
// See deploy/cloudflare/README.md for the full walkthrough.
{
  "name": "aljazeera360-mcp",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  // Serve on the account's workers.dev subdomain
  "workers_dev": true,
  "containers": [
    {
      "class_name": "AJ360Container",
      // Reuses the repo's existing Dockerfile (path relative to this file)
      "image": "../../Dockerfile",
      // One instance keeps MCP streamable-http sessions on the same backend
      "max_instances": 1,
      "instance_type": "basic"
    },
    {
      // Private team endpoint (/team/<token>/mcp) with the SEO/analytics tools.
      // Sleeps when unused, so it costs nothing between team sessions.
      "class_name": "AJ360TeamContainer",
      "image": "../../Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AJ360_CONTAINER",
        "class_name": "AJ360Container"
      },
      {
        "name": "AJ360_TEAM_CONTAINER",
        "class_name": "AJ360TeamContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AJ360Container"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AJ360TeamContainer"]
    }
  ],
  // Per-client request limits on /mcp (key = IP + mcp-session-id; the IP is
  // never stored). A real chat session makes a handful of calls a minute.
  "ratelimits": [
    { "name": "MCP_LIMITER",  "namespace_id": "3601", "simple": { "limit": 60,  "period": 60 } },
    { "name": "TEAM_LIMITER", "namespace_id": "3602", "simple": { "limit": 300, "period": 60 } }
  ],
  // Persistent usage analytics — survives container sleeps, unlike the
  // in-container SQLite dashboard. Schema in schema.sql.
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "aj360-analytics",
      "database_id": "d244d8b7-6934-49c5-834f-95b2ca8b0366"
    }
  ],
  // Daily analytics retention cleanup (see scheduled() in src/index.js).
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    // MUST match the public hostname of this Worker, or the server's
    // DNS-rebinding protection rejects requests with 421.
    // If you use a custom domain later, change this and deploy again.
    "AJ360_ALLOWED_HOST": "aljazeera360-mcp.ahmed-26d.workers.dev"
    // The public /mcp endpoint serves the 10 core tools; the SEO/analytics
    // tools live on the private team endpoint (AJ360TeamContainer). Set the
    // secret with: wrangler secret put AJ360_TEAM_TOKEN
  }
}
